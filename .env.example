# ─── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://indiradio.ca
# Live audio stream (HTTPS required for iPhone Safari). MP3/AAC Icecast/Shoutcast or HLS (.m3u8). [CONFIRM]
NEXT_PUBLIC_STREAM_URL=

# ─── Sanity CMS (leave blank to run from built-in seed content) ───────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity → /api/revalidate webhook
SANITY_REVALIDATE_SECRET=

# ─── YouTube (episode archive + "Watch Live" detection) ───────────────
YOUTUBE_CHANNEL_ID=
# Optional – enables live detection & richer data. Without it, the public RSS feed is used.
YOUTUBE_API_KEY=

# ─── Payments (Stripe) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Lead delivery ────────────────────────────────────────────────────
# GoHighLevel inbound webhook (Automation → Workflow → Inbound Webhook trigger)
GHL_WEBHOOK_URL=
# Email via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Indi Radio <website@indiradio.ca>"
# Comma-separated staff inboxes that receive every form submission [CONFIRM]
EMAIL_TO=

# ─── Spam protection ──────────────────────────────────────────────────
# Upstash Redis REST (distributed rate limiting). Falls back to in-memory if blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Analytics & verification ─────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
